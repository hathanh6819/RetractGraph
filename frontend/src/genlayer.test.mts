import test from'node:test';import assert from'node:assert/strict';import{readFileSync}from'node:fs';import{connectedWallet,studioNext}from'./genlayer.ts';
test('Studio Next chain is pinned',()=>assert.equal(studioNext.id,61997));
test('wallet rejects wrong chain',async()=>{const provider={request:async({method}:{method:string})=>method==='eth_requestAccounts'?['0x1111111111111111111111111111111111111111']:'0x1'};await assert.rejects(()=>connectedWallet(provider as never,'',(()=>({})) as never),/chain ID 61997/)});
test('wallet rejects changed account',async()=>{const provider={request:async({method}:{method:string})=>method==='eth_requestAccounts'?['0x2222222222222222222222222222222222222222']:'0xf22d'};await assert.rejects(()=>connectedWallet(provider as never,'0x1111111111111111111111111111111111111111',(()=>({})) as never),/account changed/)});
test('valid wallet is passed to client',async()=>{let seen='';const account='0x2222222222222222222222222222222222222222';const provider={request:async({method}:{method:string})=>method==='eth_requestAccounts'?[account]:'0xf22d'};const factory=((opts:{account:string})=>{seen=opts.account;return{ok:true}}) as never;const result=await connectedWallet(provider as never,'',factory);assert.equal(result.account,account);assert.equal(seen,account)});
test('writer stays within Studio phase bounds and passes the verified account',()=>{const source=readFileSync(new URL('./genlayer.ts',import.meta.url),'utf8');assert.match(source,/validatorTimeunitsAllocation:600n/);assert.doesNotMatch(source,/validatorTimeunitsAllocation:700n/);assert.match(source,/writeContract\(\{account:account/)});
